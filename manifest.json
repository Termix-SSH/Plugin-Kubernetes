{
  "id": "kubernetes",
  "name": "Kubernetes",
  "version": "1.1.0",
  "description": "Manage Kubernetes clusters from your hosts over SSH, with logs, metrics, YAML and a shell.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Kubernetes",
  "docs": "https://docs.termix.site/plugins/kubernetes",
  "video": "https://www.youtube.com/watch?v=v59kAOaXeTo",
  "category": "Infrastructure",
  "icon": "ShipWheel",
  "features": [
    "Browse pods, deployments, statefulsets, daemonsets, jobs and cronjobs",
    "Scale, restart, roll back and change images of workloads",
    "Read and download pod logs, and open a shell inside a pod",
    "View, edit and apply YAML with a dry run and diff first",
    "Services, ingresses, configmaps, secrets, volumes, nodes and events",
    "Cordon, uncordon and drain nodes",
    "CPU and memory from metrics-server",
    "Helm releases with history, values, rollback and uninstall",
    "Works with kubectl, k3s, MicroK8s and OpenShift",
    "A pods panel beside any SSH terminal",
    "A dashboard card with ready nodes and failing pods on each cluster"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "ssh:connect",
    "network:serve",
    "ui:surface",
    "events:core",
    "kv:own",
    "notify:send",
    "users:impersonate",
    "operations:provide"
  ],
  "provides": [
    {
      "service": "kubernetes.workloads",
      "version": "1.0.0",
      "permission": "kubernetes.use"
    },
    {
      "service": "kubernetes.events",
      "version": "1.0.0",
      "permission": "kubernetes.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "kubernetes",
        "titleKey": "nav.kubernetes",
        "icon": "ShipWheel",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      },
      {
        "name": "secrets",
        "titleKey": "permissions.secrets.title",
        "descriptionKey": "permissions.secrets.description",
        "defaultRoles": ["admin"]
      }
    ],
    "settings": {
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 31,
        "enableKey": "enableKubernetes",
        "enableLabelKey": "settings.host.enable.label",
        "enableDescriptionKey": "settings.host.enable.description",
        "fields": [
          {
            "key": "kubectlFlavor",
            "type": "select",
            "labelKey": "settings.host.kubectlFlavor.label",
            "descriptionKey": "settings.host.kubectlFlavor.description",
            "requires": "enableKubernetes",
            "default": "kubectl",
            "options": [
              {
                "value": "kubectl",
                "labelKey": "settings.host.kubectlFlavor.kubectl"
              },
              {
                "value": "k3s",
                "labelKey": "settings.host.kubectlFlavor.k3s"
              },
              {
                "value": "microk8s",
                "labelKey": "settings.host.kubectlFlavor.microk8s"
              },
              {
                "value": "oc",
                "labelKey": "settings.host.kubectlFlavor.oc"
              }
            ]
          },
          {
            "key": "kubeconfig",
            "type": "string",
            "labelKey": "settings.host.kubeconfig.label",
            "descriptionKey": "settings.host.kubeconfig.description",
            "placeholderKey": "settings.host.kubeconfig.placeholder",
            "default": "",
            "requires": "enableKubernetes"
          },
          {
            "key": "context",
            "type": "string",
            "labelKey": "settings.host.context.label",
            "descriptionKey": "settings.host.context.description",
            "placeholderKey": "settings.host.context.placeholder",
            "default": "",
            "requires": "enableKubernetes"
          },
          {
            "key": "namespace",
            "type": "string",
            "labelKey": "settings.host.namespace.label",
            "descriptionKey": "settings.host.namespace.description",
            "placeholderKey": "settings.host.namespace.placeholder",
            "default": "",
            "requires": "enableKubernetes"
          },
          {
            "key": "useSudo",
            "type": "boolean",
            "labelKey": "settings.host.useSudo.label",
            "descriptionKey": "settings.host.useSudo.description",
            "default": false,
            "requires": "enableKubernetes"
          },
          {
            "key": "alertProblems",
            "type": "boolean",
            "labelKey": "settings.host.alertProblems.label",
            "descriptionKey": "settings.host.alertProblems.description",
            "default": false,
            "requires": "enableKubernetes"
          },
          {
            "key": "readOnly",
            "type": "boolean",
            "labelKey": "settings.host.readOnly.label",
            "descriptionKey": "settings.host.readOnly.description",
            "default": false,
            "requires": "enableKubernetes"
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableKubernetes"
          }
        ]
      },
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 380
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "uiPresets": {
      "simple": {
        "layout": "card"
      },
      "balanced": {
        "layout": "table"
      },
      "advanced": {
        "layout": "table"
      }
    },
    "uses": ["homepage.widgets", "terminal.resolveTheme"],
    "dashboardCards": [
      {
        "id": "kubernetes-clusters",
        "titleKey": "card.title",
        "icon": "ShipWheel"
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "kubernetes.list-pods",
          "titleKey": "operations.pods.list",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableKubernetes": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "kubernetes.list-workloads",
          "titleKey": "operations.workloads.list",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableKubernetes": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "kubernetes.summary",
          "titleKey": "operations.summary.title",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableKubernetes": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "kubernetes.restart-workload",
          "titleKey": "operations.workloads.restart",
          "scope": "resource",
          "resource": "kubernetes.workload",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableKubernetes": true
            }
          },
          "icon": "RotateCw",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "kubernetes.scale-workload",
          "titleKey": "operations.workloads.scale",
          "scope": "resource",
          "resource": "kubernetes.workload",
          "risk": "change",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableKubernetes": true
            }
          },
          "icon": "Scaling",
          "idempotent": true,
          "inputs": [
            {
              "key": "replicas",
              "type": "number",
              "labelKey": "operations.workloads.replicas",
              "required": true,
              "min": 0,
              "max": 1000
            }
          ]
        },
        {
          "id": "kubernetes.delete-pod",
          "titleKey": "operations.pods.delete",
          "scope": "resource",
          "resource": "kubernetes.pod",
          "risk": "destructive",
          "permission": "use",
          "hostAccess": "edit",
          "dryRun": "describe",
          "when": {
            "settings": {
              "enableKubernetes": true
            }
          },
          "icon": "Trash2"
        }
      ],
      "resources": [
        {
          "id": "kubernetes.pod",
          "titleKey": "operations.pods.title",
          "icon": "Box",
          "list": "kubernetes.list-pods",
          "key": "id",
          "name": "name",
          "status": "status",
          "tab": "kubernetes",
          "columns": [
            {
              "key": "namespace",
              "titleKey": "operations.namespace"
            },
            {
              "key": "ready",
              "titleKey": "operations.pods.ready"
            },
            {
              "key": "restarts",
              "titleKey": "operations.pods.restarts"
            }
          ],
          "filters": ["namespace", "status"]
        },
        {
          "id": "kubernetes.workload",
          "titleKey": "operations.workloads.title",
          "icon": "Layers",
          "list": "kubernetes.list-workloads",
          "key": "id",
          "name": "name",
          "status": "status",
          "tab": "kubernetes",
          "columns": [
            {
              "key": "kind",
              "titleKey": "operations.workloads.kind"
            },
            {
              "key": "namespace",
              "titleKey": "operations.namespace"
            }
          ],
          "filters": ["kind", "namespace"]
        }
      ],
      "signals": [
        {
          "id": "kubernetes.failing-pods",
          "titleKey": "operations.summary.title",
          "read": "kubernetes.summary",
          "scope": "host",
          "kind": "count",
          "refreshSec": 60
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
